#!/bin/sh
# pre-commit: smoke-тест правила сегментации (fast, ~0.03 с, без Stanza).
#
# Зачем: 27.10.2026 в config.json ушла лишняя запятая — судья перестал
# запускаться на 3 дня, хотя в коммите было написано «reg 52/52». Гейт ловит это
# до коммита. WARN (известные расхождения) коммит НЕ блокируют, FAIL — блокирует.
#
# Установка:  cp rule/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x ../.git/hooks/pre-commit
# Удаление:   rm .git/hooks/pre-commit
# Полная проверка (со Stanza): python rule/smoke_test.py --full

RULE_DIR="rule"
[ -f "$RULE_DIR/smoke_test.py" ] || exit 0

# Python ищем в порядке: .venv проекта (эталон 3.15) → py -3.15 → python/python3 из PATH.
# Причина (замер 19.11): в Windows «python» из PATH — часто заглушка Microsoft Store
# («Python was not found», код 1): гейт ложно падал и блокировал коммит, хотя правила целые.
# Приёмка проекта тоже запускается ИЗ .venv — гейт следует тому же правилу.
PY=""
for c in .venv/Scripts/python.exe .venv/bin/python; do
  [ -f "$c" ] && PY="$c" && break
done
if [ -z "$PY" ] && command -v py >/dev/null 2>&1; then
  PY=$(py -3.15 -c "import sys;print(sys.executable)" 2>/dev/null)
fi
if [ -z "$PY" ]; then
  PY=$(command -v python3 || command -v python || true)
fi
case "$PY" in
  *WindowsApps*) PY="" ;;
esac
if [ -z "$PY" ]; then
  echo "pre-commit: python (.venv/Scripts/python.exe, py -3.15, python3) не найден — smoke-тест пропущен"
  echo "  поднимите окружение: .\\install.ps1  (или запустите гейт руками из .venv)"
  exit 0
fi

if ! PYTHONIOENCODING=utf-8 "$PY" "$RULE_DIR/smoke_test.py" --quiet; then
  echo ""
  echo "pre-commit: smoke-тест правила НЕ прошёл — коммит отменён."
  echo "Подробный отчёт: python $RULE_DIR/smoke_test.py"
  echo "Обойти (осознанно): git commit --no-verify"
  exit 1
fi
exit 0
