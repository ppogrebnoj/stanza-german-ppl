{
  "source": "docs/flags.json",
  "contract": "Только канонические флаги; legacy-алиасы удалены. Unknown flag => code 4.",
  "checks": ["inventory", "ready", "plan", "mcp", "status", "capabilities"],
  "steps": ["winget", "powershell", "python", "git", "workspace", "venv", "deps", "models", "snippet", "doctor", "acceptance"],
  "exit_codes": {
    "0": "OK / SKIP",
    "1": "FAIL non-retryable",
    "2": "BLOCK",
    "3": "FAIL retryable",
    "4": "BROKEN",
    "5": "DELIVERY"
  },
  "flags": [
    {"name": "Yes", "kind": "switch", "description": "разрешить установку системного софта и связанные шаги"},
    {"name": "Check", "kind": "value", "values": ["inventory", "ready", "plan", "mcp", "status", "capabilities"], "default": "inventory", "description": "режим только чтение; файлы отчётов не пишутся"},
    {"name": "Acceptance", "kind": "switch", "description": "добавить шаг acceptance с приёмкой F1"},
    {"name": "Json", "kind": "switch", "description": "финальный JSON в stdout"},
    {"name": "ProgressJson", "kind": "switch", "description": "NDJSON-события в stdout; в -Check файл не пишется"},
    {"name": "ArtifactDir", "kind": "value", "default": ".tmp", "description": "каталог install.log, progress.ndjson, отчётов и mcp-snippet"},
    {"name": "Python", "kind": "value", "description": "явный интерпретатор 3.15 x64"},
    {"name": "TargetDir", "kind": "value", "default": "%LOCALAPPDATA%\\Programs\\Python\\Python315", "description": "каталог установки Python"},
    {"name": "ModelsDir", "kind": "value", "default": "<root>\\.stanza\\models", "description": "каталог ресурсов моделей Stanza"},
    {"name": "Models", "kind": "value", "description": "дополнительные процессоры (ner,sentiment) или all"},
    {"name": "OfflineKit", "kind": "value", "description": "офлайн-набор: архив репозитория + колёса + модели"},
    {"name": "Steps", "kind": "value", "description": "выполнить указанные шаги (id[,id])"},
    {"name": "Resume", "kind": "switch", "description": "продолжить прерванный прогон, готовые шаги SKIP"},
    {"name": "Force", "kind": "switch", "description": "опасные операции: git reset, удаление моделей, uninstall"},
    {"name": "Repair", "kind": "switch", "description": "ремонт сломанных шагов"},
    {"name": "Uninstall", "kind": "switch", "description": "удалить созданные установщиком файлы"},
    {"name": "Update", "kind": "switch", "description": "обновить пакеты и модели"},
    {"name": "CheckUpdates", "kind": "switch", "description": "проверить наличие обновлений без записи"},
    {"name": "RaisePython", "kind": "switch", "description": "команда обновления Python до поддерживаемой версии"},
    {"name": "MakeOfflineKit", "kind": "switch", "description": "собрать офлайн-набор в ArtifactDir"},
    {"name": "Retries", "kind": "value", "description": "число попыток сетевых шагов", "default": "4"}
  ]
}
