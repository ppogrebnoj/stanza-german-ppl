{
  "source": "docs/flags.json",
  "contract": "install.ps1 and scripts/all.ps1 accept exactly this set; unknown flag => code 4",
  "checks": ["inventory", "ready", "plan", "mcp", "status", "capabilities"],
  "steps": ["winget", "python", "git", "deps", "models", "snippet", "doctor", "acceptance"],
  "flags": [
    {"name": "Yes", "kind": "switch", "description": "разрешить установку системного софта и связанные шаги"},
    {"name": "Check", "kind": "value", "values": ["inventory", "ready", "plan", "mcp", "status", "capabilities"], "default": "inventory", "description": "режим только чтение"},
    {"name": "Acceptance", "kind": "switch", "description": "doctor + smoke fast/full + валидаторы + mcp_probe -> JSON с F1"},
    {"name": "Json", "kind": "switch", "description": "финальный JSON в stdout"},
    {"name": "ProgressJson", "kind": "switch", "description": "NDJSON-события в stdout (в файл пишутся всегда)"},
    {"name": "ArtifactDir", "kind": "value", "default": ".tmp", "description": "каталог логов, отчётов, прогресса и загрузок"},
    {"name": "Python", "kind": "value", "description": "явный интерпретатор (принимается инвентаризацией)"},
    {"name": "TargetDir", "kind": "value", "default": "%LOCALAPPDATA%\\Programs\\Python\\Python315", "description": "каталог установки Python"},
    {"name": "ModelsDir", "kind": "value", "default": "<root>\\.stanza\\models", "description": "каталог ресурсов моделей Stanza"},
    {"name": "Models", "kind": "value", "description": "дополнительные процессоры (ner,sentiment) или all"},
    {"name": "OfflineKit", "kind": "value", "description": "офлайн-набор: архив репозитория + колёса + модели"},
    {"name": "Steps", "kind": "value", "description": "выполнить указанные шаги (id[,id])"},
    {"name": "Resume", "kind": "switch", "description": "продолжить прерванный прогон, готовые шаги SKIP"},
    {"name": "Venv", "kind": "switch", "description": "создать .venv и ставить пакеты в него"},
    {"name": "Force", "kind": "switch", "description": "опасные операции: перезапись, git reset --hard, удаление моделей"},
    {"name": "Repair", "kind": "switch", "description": "ремонт: переустановить сломанные шаги"},
    {"name": "Uninstall", "kind": "switch", "description": "удалить созданные установщиком файлы"},
    {"name": "Update", "kind": "switch", "description": "обновить пакеты и модели"},
    {"name": "CheckUpdates", "kind": "switch", "description": "проверить наличие обновлений без записи"},
    {"name": "RaisePython", "kind": "switch", "description": "команда обновления Python до поддерживаемой версии"},
    {"name": "MakeOfflineKit", "kind": "switch", "description": "собрать офлайн-набор в ArtifactDir"},
    {"name": "Inventory", "kind": "switch", "alias": "Check inventory", "description": "совместимость: то же, что -Check inventory"},
    {"name": "InventoryOnly", "kind": "switch", "alias": "Check inventory", "description": "совместимость: то же, что -Check inventory"},
    {"name": "CheckOnly", "kind": "switch", "alias": "Check ready", "description": "совместимость: то же, что -Check ready"},
    {"name": "DryRun", "kind": "switch", "alias": "Check plan", "description": "совместимость: то же, что -Check plan"},
    {"name": "Zip", "kind": "value", "alias": "OfflineKit", "description": "совместимость: архив моделей"},
    {"name": "Log", "kind": "value", "alias": "ArtifactDir", "description": "совместимость: каталог артефактов"},
    {"name": "Retries", "kind": "value", "description": "число попыток сетевых шагов", "default": "4"}
  ]
}
