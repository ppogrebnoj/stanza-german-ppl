{
  "mcpServers": {
    "stanza-german": {
      "command": "<PROJECT_ROOT>\\.venv\\Scripts\\python.exe",
      "args": ["<PROJECT_ROOT>\\MCP-stanza-german\\server.py"],
      "env": {
        "RULE_ROOT": "<PROJECT_ROOT>\\rule",
        "PYTHONUTF8": "1",
        "STANZA_RESOURCES_DIR": "<PROJECT_ROOT>\\.stanza\\models"
      }
    }
  }
}
